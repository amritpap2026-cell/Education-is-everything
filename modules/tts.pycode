"""Free voiceover generation using Edge-TTS with retry and voice fallback."""
import asyncio
import edge_tts
from pathlib import Path

TEMP_DIR = Path("assets/temp")
TEMP_DIR.mkdir(parents=True, exist_ok=True)

VOICES = {
        "English": ["en-US-GuyNeural", "en-US-JennyNeural", "en-US-AndrewMultilingualNeural", "en-GB-RyanNeural"],
            "Hindi": ["hi-IN-MadhurNeural", "hi-IN-SwaraNeural"],
                "Nepali": ["ne-NP-HemkalaNeural", "ne-NP-SagarNeural"],
}


async def _stream_tts(text: str, voice: str, output_path: str, srt_path: str):
    communicate = edge_tts.Communicate(text, voice)
        submaker = edge_tts.SubMaker()

            audio_bytes = 0
                with open(output_path, "wb") as audio_file:
                        async for chunk in communicate.stream():
                                    if chunk["type"] == "audio":
                                                    audio_file.write(chunk["data"])
                                                                    audio_bytes += len(chunk["data"])
                                                                                elif chunk["type"] in ("WordBoundary", "SentenceBoundary"):
                                                                                                try:
                                                                                                                    submaker.create_sub((chunk["offset"], chunk["duration"]), chunk["text"])
                                                                                                                                    except AttributeError:
                                                                                                                                                        try:
                                                                                                                                                                                submaker.add_cue((chunk["offset"], chunk["duration"]), chunk["text"])
                                                                                                                                                                                                    except AttributeError:
                                                                                                                                                                                                                            try:
                                                                                                                                                                                                                                                        submaker.feed(chunk)
                                                                                                                                                                                                                                                                                except AttributeError:
                                                                                                                                                                                                                                                                                                            pass

                                                                                                                                                                                                                                                                                                                if audio_bytes == 0:
                                                                                                                                                                                                                                                                                                                        raise RuntimeError(f"No audio received for voice {voice}")

                                                                                                                                                                                                                                                                                                                            with open(srt_path, "w", encoding="utf-8") as srt_file:
                                                                                                                                                                                                                                                                                                                                    try:
                                                                                                                                                                                                                                                                                                                                                srt_file.write(submaker.generate_subs())
                                                                                                                                                                                                                                                                                                                                                        except AttributeError:
                                                                                                                                                                                                                                                                                                                                                                    try:
                                                                                                                                                                                                                                                                                                                                                                                    srt_file.write(submaker.get_srt())
                                                                                                                                                                                                                                                                                                                                                                                                except AttributeError:
                                                                                                                                                                                                                                                                                                                                                                                                                srt_file.write("")


                                                                                                                                                                                                                                                                                                                                                                                                                def generate_voiceover(full_script: str, language: str = "English") -> tuple[str, str]:
                                                                                                                                                                                                                                                                                                                                                                                                                    """Generates MP3 and SRT files. Tries multiple voices if one fails."""
                                                                                                                                                                                                                                                                                                                                                                                                                        voices = VOICES.get(language, VOICES["English"])
                                                                                                                                                                                                                                                                                                                                                                                                                            audio_path = TEMP_DIR / "voiceover.mp3"
                                                                                                                                                                                                                                                                                                                                                                                                                                srt_path = TEMP_DIR / "subtitles.srt"

                                                                                                                                                                                                                                                                                                                                                                                                                                    last_error = None
                                                                                                                                                                                                                                                                                                                                                                                                                                        for voice in voices:
                                                                                                                                                                                                                                                                                                                                                                                                                                                try:
                                                                                                                                                                                                                                                                                                                                                                                                                                                            print(f"   Trying voice: {voice}")
                                                                                                                                                                                                                                                                                                                                                                                                                                                                        asyncio.run(_stream_tts(full_script, voice, str(audio_path), str(srt_path)))
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    print(f"   ✓ Voiceover generated: {voice}")
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                return str(audio_path), str(srt_path)
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        except Exception as e:
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    print(f"   ✗ Voice {voice} failed: {str(e)[:80]}")
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                last_error = e
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            continue

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                raise RuntimeError(f"All TTS voices failed. Last error: {last_error}")
}